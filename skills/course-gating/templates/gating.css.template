/* ============================================================
   Course Gating styles
   Generated by the course-gating skill, Path A.
   Designed to inherit your existing CSS variables (--brand,
   --brand-soft, --bg-soft, --rule, --radius-md, --radius-sm,
   --muted, --shadow-sm). If those are not defined, sensible
   fallbacks apply.
   ============================================================ */

:root {
  --gating-locked-opacity: 0.55;
  --gating-lock-bg: var(--bg-soft, #FAFAFA);
  --gating-lock-border: var(--rule, #eaeaea);
  --gating-lock-radius: var(--radius-md, 10px);
  --gating-lock-cta-bg: var(--brand, #D6006C);
}

/* Locked unit card on the index */
.unit-card.locked {
  opacity: var(--gating-locked-opacity);
  cursor: not-allowed;
  pointer-events: auto; /* keep auto so click handler runs and blocks */
  position: relative;
}
.unit-card.locked:hover {
  transform: none;
  box-shadow: var(--shadow-sm, 0 1px 3px rgba(10,10,10,0.06));
}
.unit-card.locked::after {
  content: "Locked";
  position: absolute;
  top: 12px;
  right: 12px;
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--muted, rgba(10,10,10,0.65));
  background: var(--gating-lock-bg);
  padding: 4px 10px;
  border-radius: 4px;
  border: 1px solid var(--gating-lock-border);
}

/* Locked final CTA on the index */
.final-callout .cta.locked-final-cta {
  opacity: var(--gating-locked-opacity);
  cursor: not-allowed;
  background: var(--muted, #999) !important;
}

/* Lock card shown on a locked unit page or final page */
.gating-lockout {
  max-width: 640px;
  margin: 48px auto;
  padding: 40px 32px;
  text-align: center;
  border: 1px solid var(--gating-lock-border);
  border-radius: var(--gating-lock-radius);
  background: var(--gating-lock-bg);
}
.gating-lockout h2 {
  color: var(--brand, #D6006C);
  margin-top: 0;
  font-size: 1.6rem;
}
.gating-lockout p {
  margin: 0.8em 0;
  font-size: 1.05rem;
  line-height: 1.6;
}
.gating-lockout ul {
  list-style: none;
  padding: 0;
  margin: 1em 0;
}
.gating-lockout ul li {
  padding: 6px 0;
  font-weight: 600;
}
.gating-lockout .gating-cta {
  display: inline-block;
  margin-top: 16px;
  padding: 12px 24px;
  background: var(--gating-lock-cta-bg);
  color: #FFFFFF;
  text-decoration: none;
  font-weight: 700;
  border-radius: var(--radius-sm, 6px);
  transition: opacity 200ms ease;
}
.gating-lockout .gating-cta:hover {
  opacity: 0.9;
}
.gating-lockout .gating-reset {
  margin-top: 32px;
  padding-top: 20px;
  border-top: 1px solid var(--gating-lock-border);
  font-size: 0.85rem;
  color: var(--muted, rgba(10,10,10,0.65));
}
.gating-lockout .gating-reset-link {
  color: var(--muted, rgba(10,10,10,0.65));
  text-decoration: underline;
}
.gating-lockout .gating-reset-link:hover {
  color: var(--brand, #D6006C);
}
