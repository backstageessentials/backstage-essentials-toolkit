/* ============================================================
   Course Gating
   Generated by the course-gating skill, Path A.
   Reads existing localStorage keys produced by the static-web
   generator. Adds: prior-unit-complete enforcement on unit and
   final pages, plus locked-card state on the index.

   To remove, run the course-gating skill in remove mode.
   ============================================================ */

(function () {
  "use strict";

  var CONFIG = /* CONFIG_INJECTED */;

  // ---------- localStorage helpers ----------

  function readJson(key) {
    try {
      var raw = window.localStorage.getItem(key);
      if (!raw) return null;
      return JSON.parse(raw);
    } catch (e) {
      return null;
    }
  }

  function getViewedLessons() {
    var key = "course-" + CONFIG.courseSlug + "-viewed-lessons";
    var arr = readJson(key);
    var set = {};
    if (Array.isArray(arr)) {
      for (var i = 0; i < arr.length; i++) {
        set[arr[i]] = true;
      }
    }
    return set;
  }

  function getQuizAttempts(storageKey) {
    var arr = readJson(storageKey);
    return Array.isArray(arr) ? arr : [];
  }

  function quizPassed(storageKey) {
    var attempts = getQuizAttempts(storageKey);
    for (var i = 0; i < attempts.length; i++) {
      if (attempts[i] && attempts[i].passed === true) {
        return true;
      }
    }
    return false;
  }

  // ---------- completion logic ----------

  function isUnitComplete(unit) {
    var viewed = getViewedLessons();
    for (var i = 0; i < unit.lessonIds.length; i++) {
      if (!viewed[unit.lessonIds[i]]) return false;
    }
    if (CONFIG.requireQuizPass !== false && unit.kcStorageKey) {
      if (!quizPassed(unit.kcStorageKey)) return false;
    }
    return true;
  }

  function findFirstIncompleteUnit() {
    for (var i = 0; i < CONFIG.units.length; i++) {
      if (!isUnitComplete(CONFIG.units[i])) return CONFIG.units[i];
    }
    return null;
  }

  function priorUnitsComplete(currentUnitNumber) {
    for (var i = 0; i < CONFIG.units.length; i++) {
      var u = CONFIG.units[i];
      if (u.number >= currentUnitNumber) break;
      if (!isUnitComplete(u)) return { complete: false, blocker: u };
    }
    return { complete: true, blocker: null };
  }

  // ---------- page detection ----------

  function getCurrentUnitNumber() {
    // unit pages are named unit-N.html
    var match = window.location.pathname.match(/unit-(\d+)\.html$/);
    if (match) return parseInt(match[1], 10);
    return null;
  }

  function isFinalPage() {
    return /\/final\.html$/.test(window.location.pathname) ||
           window.location.pathname.endsWith("final.html");
  }

  function isIndexPage() {
    var p = window.location.pathname;
    return p.endsWith("/") || p.endsWith("/index.html") || p.endsWith("index.html");
  }

  // ---------- lock UI rendering ----------

  function renderUnitLockout(blockerUnit) {
    var content = document.getElementById("gated-content");
    if (!content) return;
    content.style.display = "none";

    var lock = document.createElement("section");
    lock.className = "gating-lockout fade-in visible";
    lock.innerHTML =
      '<h2>This unit is locked</h2>' +
      '<p>Complete <strong>Unit ' + blockerUnit.number + '</strong> first. ' +
      'Read every lesson and pass the unit knowledge check.</p>' +
      '<a class="gating-cta" href="unit-' + blockerUnit.number + '.html">' +
      'Go to Unit ' + blockerUnit.number + '</a>' +
      '<p class="gating-reset"><a href="#" class="gating-reset-link">' +
      'Reset progress for this course</a></p>';

    content.parentNode.insertBefore(lock, content);
    wireResetLink(lock);
  }

  function renderFinalLockout(incompleteUnits) {
    var content = document.getElementById("gated-content");
    if (!content) return;
    content.style.display = "none";

    var unitList = incompleteUnits.map(function (u) {
      return '<li>Unit ' + u.number + '</li>';
    }).join("");

    var lock = document.createElement("section");
    lock.className = "gating-lockout fade-in visible";
    lock.innerHTML =
      '<h2>The final assessment is locked</h2>' +
      '<p>Complete every unit before taking the final. Still incomplete:</p>' +
      '<ul style="text-align:left;display:inline-block;margin:0 auto;">' +
      unitList + '</ul>' +
      '<p><a class="gating-cta" href="index.html">Back to course home</a></p>' +
      '<p class="gating-reset"><a href="#" class="gating-reset-link">' +
      'Reset progress for this course</a></p>';

    content.parentNode.insertBefore(lock, content);
    wireResetLink(lock);
  }

  function wireResetLink(lockEl) {
    var link = lockEl.querySelector(".gating-reset-link");
    if (!link) return;
    link.addEventListener("click", function (e) {
      e.preventDefault();
      if (!window.confirm(
        "Reset all progress for this course? You will need to re-read every lesson and re-pass every quiz."
      )) return;
      resetProgress();
      window.location.reload();
    });
  }

  function resetProgress() {
    // Remove viewed lessons key
    window.localStorage.removeItem(
      "course-" + CONFIG.courseSlug + "-viewed-lessons"
    );
    // Remove every quiz storage key
    for (var i = 0; i < CONFIG.units.length; i++) {
      if (CONFIG.units[i].kcStorageKey) {
        window.localStorage.removeItem(CONFIG.units[i].kcStorageKey);
      }
    }
    if (CONFIG.final && CONFIG.final.storageKey) {
      window.localStorage.removeItem(CONFIG.final.storageKey);
    }
  }

  // ---------- index card locking ----------

  function gateIndexPage() {
    var cards = document.querySelectorAll(".unit-card[data-unit-number]");
    for (var i = 0; i < cards.length; i++) {
      var card = cards[i];
      var n = parseInt(card.getAttribute("data-unit-number"), 10);
      if (isNaN(n) || n <= 1) continue;  // unit 1 is always unlocked

      var prereq = priorUnitsComplete(n);
      if (!prereq.complete) {
        card.classList.add("locked");
        // Block click navigation
        card.addEventListener("click", interceptClick, true);
      }
    }

    // Also lock the final CTA
    var finalCta = document.querySelector(".final-callout .cta[href*='final.html']");
    if (finalCta) {
      var allComplete = true;
      for (var j = 0; j < CONFIG.units.length; j++) {
        if (!isUnitComplete(CONFIG.units[j])) { allComplete = false; break; }
      }
      if (!allComplete) {
        finalCta.classList.add("locked-final-cta");
        finalCta.addEventListener("click", interceptClick, true);
      }
    }
  }

  function interceptClick(e) {
    e.preventDefault();
    e.stopPropagation();
    // Visible flash effect could go here. For now, silent.
    return false;
  }

  // ---------- per-page gating ----------

  function gateUnitPage(currentUnitNumber) {
    var prereq = priorUnitsComplete(currentUnitNumber);
    if (!prereq.complete) {
      renderUnitLockout(prereq.blocker);
    }
  }

  function gateFinalPage() {
    var incomplete = [];
    for (var i = 0; i < CONFIG.units.length; i++) {
      if (!isUnitComplete(CONFIG.units[i])) incomplete.push(CONFIG.units[i]);
    }
    if (incomplete.length > 0) {
      renderFinalLockout(incomplete);
    }
  }

  // ---------- entry point ----------

  function init() {
    var unitN = getCurrentUnitNumber();
    if (unitN !== null) {
      gateUnitPage(unitN);
      return;
    }
    if (isFinalPage()) {
      gateFinalPage();
      return;
    }
    if (isIndexPage()) {
      gateIndexPage();
      return;
    }
    // Other pages (lesson detail, etc.) are not gated by this script.
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
