# Static web courses do not require secrets for the basic build.
# This file is here for consistency. Add values only if you use them.

# Optional: if deploying to a non-default location
DEPLOY_TARGET=github-pages
DEPLOY_BRANCH=gh-pages

# Optional: if using Cloudflare Pages or Netlify with API deploys
# NETLIFY_AUTH_TOKEN=
# CLOUDFLARE_API_TOKEN=
