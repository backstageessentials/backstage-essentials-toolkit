# PDF generation runs locally. No remote API, no token, no rate limit.
# This file exists for consistency with other platforms but is not
# strictly required: the renderer works with no .env at all.
#
# All values below are optional. Uncomment and edit only what you need.

# Where to write the PDF and intermediate HTML. Default: ./build/pdf
# OUTPUT_DIR=./build/pdf

# Override the WeasyPrint discovery path. Useful if you have multiple
# Python environments and want a specific weasyprint binary. Default:
# the toolkit imports weasyprint via Python's normal import path.
# WEASYPRINT_BIN=

# Override the Chrome path used by the headless fallback. Default:
# the toolkit looks for google-chrome / chromium / chrome on PATH, then
# /Applications/Google Chrome.app/Contents/MacOS/Google Chrome.
# CHROME_PATH=
