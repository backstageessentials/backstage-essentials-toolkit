# Copy this file to .env and fill in your actual values.
# .env is gitignored and never committed.
#
# Canvas access tokens grant the same permissions as the user who created
# them. Treat the token like a password. Rotate it when staff turns over
# and revoke unused tokens from Account, Settings, Approved Integrations.
#
# To generate a token:
#   1. Sign in to your Canvas instance.
#   2. Click Account, then Settings.
#   3. Scroll to Approved Integrations and click + New Access Token.
#   4. Give it a purpose ("backstage essentials toolkit") and an expiration.
#   5. Copy the token value the moment Canvas shows it. It cannot be
#      retrieved later. Save it in 1Password.

# Your Canvas instance base URL (no trailing slash).
# Hosted instance: https://canvas.instructure.com
# Institutional:   https://your-school.instructure.com
CANVAS_API_URL=https://your-canvas-host

# The bearer token generated above.
CANVAS_API_TOKEN=your_api_token_here
