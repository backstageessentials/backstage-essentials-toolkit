# Copy this file to .env and fill in your actual values.
# .env is gitignored and never committed.
#
# TalentLMS has a permanent free tier (up to 5 users, 10 courses) that
# includes full API access. Sign up at https://www.talentlms.com if you
# do not have an account yet.
#
# To generate an API key:
#   1. Sign in to your TalentLMS account.
#   2. Open Account & Settings, then API.
#   3. Copy the API key shown there. The free tier provides one key per
#      account. Treat it like a password. Save it in 1Password.
#   4. Rotate the key (Generate new) if it ever leaks; update .env after.

# Your TalentLMS subdomain URL (no trailing slash).
# Example: https://acmestudio.talentlms.com
# The sync auto-appends /api/v1 to this URL.
TALENTLMS_API_URL=https://your-domain.talentlms.com

# The API key generated above.
TALENTLMS_API_KEY=your_api_key_here
